import 'dotenv/config';
import { connectDB, runMigrations, disconnectDB } from './db.js';

async function main() {
  try {
    await connectDB();
    await runMigrations();
    console.log('Database migrations completed successfully.');
  } catch (err) {
    console.error('Migration failed:', err);
    process.exit(1);
  } finally {
    await disconnectDB();
  }
}

main();
