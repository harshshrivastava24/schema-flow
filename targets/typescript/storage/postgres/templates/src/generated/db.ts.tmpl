import pg from 'pg';
import { drizzle as drizzlePg } from 'drizzle-orm/node-postgres';
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import * as schema from './schema.js';

export let pool: pg.Pool | null = null;
export let db: any = null;
export let isPGlite = false;
let pgliteClient: any = null;

export async function connectDB(connectionString?: string) {
  const url = connectionString || process.env.DATABASE_URL;

  if (!url || url === ':memory:' || url.startsWith('pglite:')) {
    // In-memory PGlite fallback for local development & automated test suites
    const { PGlite } = await import('@electric-sql/pglite');
    const { pgcrypto } = await import('@electric-sql/pglite/contrib/pgcrypto');
    const { drizzle } = await import('drizzle-orm/pglite');

    pgliteClient = new PGlite({ extensions: { pgcrypto } });
    db = drizzle(pgliteClient, { schema });
    isPGlite = true;
    return db;
  }

  pool = new pg.Pool({ connectionString: url });
  await pool.query('SELECT 1');
  db = drizzlePg(pool, { schema });
  isPGlite = false;
  return db;
}

export async function disconnectDB() {
  if (pool) {
    await pool.end();
    pool = null;
  }
  if (pgliteClient) {
    await pgliteClient.close?.();
    pgliteClient = null;
  }
  db = null;
}

export async function runMigrations() {
  if (!db) {
    await connectDB();
  }

  // 1. Ensure migration ledger exists
  const createLedgerSql = `
    CREATE TABLE IF NOT EXISTS _schemaflow_migrations (
      id SERIAL PRIMARY KEY,
      name VARCHAR(255) NOT NULL UNIQUE,
      applied_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
    );
  `;

  if (isPGlite && pgliteClient) {
    await pgliteClient.exec(createLedgerSql);
  } else if (pool) {
    await pool.query(createLedgerSql);
  }

  // 2. Check if 0001_init.sql has already been applied
  const checkSql = "SELECT 1 FROM _schemaflow_migrations WHERE name = '0001_init.sql'";
  let alreadyApplied = false;

  if (isPGlite && pgliteClient) {
    const res = await pgliteClient.query(checkSql);
    alreadyApplied = res.rows.length > 0;
  } else if (pool) {
    const res = await pool.query(checkSql);
    alreadyApplied = res.rows.length > 0;
  }

  if (alreadyApplied) {
    return;
  }

  // 3. Locate and read 0001_init.sql
  const candidates = [
    path.resolve(process.cwd(), 'migrations', '0001_init.sql'),
    path.resolve(process.cwd(), 'generated', 'migrations', '0001_init.sql'),
    path.resolve(process.cwd(), 'dist', 'migrations', '0001_init.sql'),
    path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../../migrations/0001_init.sql'),
    path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../../../migrations/0001_init.sql')
  ];

  let sqlPath = '';
  for (const c of candidates) {
    if (fs.existsSync(c)) {
      sqlPath = c;
      break;
    }
  }

  if (!sqlPath) {
    throw new Error('Migration file 0001_init.sql not found in expected locations.');
  }

  const sqlContent = fs.readFileSync(sqlPath, 'utf8');

  // 4. Apply migration DDL
  if (isPGlite && pgliteClient) {
    await pgliteClient.exec(sqlContent);
    await pgliteClient.query("INSERT INTO _schemaflow_migrations (name) VALUES ('0001_init.sql')");
  } else if (pool) {
    const client = await pool.connect();
    try {
      await client.query('BEGIN');
      await client.query(sqlContent);
      await client.query("INSERT INTO _schemaflow_migrations (name) VALUES ('0001_init.sql')");
      await client.query('COMMIT');
    } catch (err) {
      await client.query('ROLLBACK');
      throw err;
    } finally {
      client.release();
    }
  }
}
